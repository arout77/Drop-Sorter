<Window x:Class="DropSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropSorter" Width="326" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- round "traffic light" window buttons; the glyph appears on hover -->
        <Style x:Key="Light" TargetType="Button">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#40000000" StrokeThickness="0.6"/>
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="28" CornerRadius="10" Background="#D9181B26"
            BorderBrush="#33FFFFFF" BorderThickness="1" AllowDrop="True"
            RenderTransformOrigin="0.5,0.5"
            DragEnter="Root_DragEnter" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop"
            MouseLeftButtonDown="Root_MouseDown" MouseMove="Root_MouseMove"
            MouseLeftButtonUp="Root_MouseUp" LostMouseCapture="Root_LostCapture">
        <Border.RenderTransform>
            <TransformGroup>
                <SkewTransform x:Name="Skew"/>
                <RotateTransform x:Name="Tilt"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="Shadow" Color="Black" Direction="270" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="14,11,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Light}" Background="#FF5F57" Click="Close_Click" ToolTip="Quit DropSorter">
                        <Path Data="M0,0 L6,6 M6,0 L0,6" Stroke="#8A1F1A" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource Light}" Background="#FEBC2E" Click="Hide_Click" ToolTip="Hide to tray">
                        <Path Data="M0,0 L7,0" Stroke="#8A5A00" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="HistoryBtn" Content="History ▾" Style="{StaticResource Flat}" Click="History_Click"/>
                    <Button Content="⚙" Style="{StaticResource Flat}" Click="Settings_Click" ToolTip="Settings"/>
                </StackPanel>
            </Grid>

            <Border x:Name="Zone" Margin="12,8,12,12" Padding="22,30" CornerRadius="10"
                    BorderBrush="#55FFFFFF" BorderThickness="1" Background="#22FFFFFF">
                <StackPanel>
                    <TextBlock Text="⤓" Foreground="#BBFFFFFF" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Status" Text="Drop files here" Foreground="#DDFFFFFF" FontSize="17"
                               FontFamily="pack://application:,,,/Fonts/#Sora, Segoe UI Variable Display, Segoe UI"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="EmptyText" Text="No activity yet" Foreground="#77FFFFFF" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed"/>

            <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" MaxHeight="260"
                     Margin="10,0,10,10" Visibility="Collapsed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" Foreground="#EEFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Foreground="#88FFFFFF" FontSize="10"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Undo" Tag="{Binding}" Click="Undo_Click"
                                    Style="{StaticResource Flat}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
