<Window x:Class="DropSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropSorter" Width="290" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="10" CornerRadius="14" Background="#D9181B26"
            BorderBrush="#33FFFFFF" BorderThickness="1" AllowDrop="True"
            DragEnter="Root_DragEnter" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop"
            MouseLeftButtonDown="Root_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="14,8,8,0">
                <TextBlock Text="DropSorter" Foreground="#99FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="HistoryBtn" Content="History ▾" Style="{StaticResource Flat}" Click="History_Click"/>
                    <Button Content="⚙" Style="{StaticResource Flat}" Click="Settings_Click" ToolTip="Settings"/>
                    <Button Content="–" Style="{StaticResource Flat}" Click="Hide_Click" ToolTip="Hide (use the tray icon to bring it back)"/>
                </StackPanel>
            </Grid>

            <Border x:Name="Zone" Margin="12,6,12,12" Padding="12,20" CornerRadius="10"
                    BorderBrush="#55FFFFFF" BorderThickness="1" Background="Transparent">
                <StackPanel>
                    <TextBlock Text="⤓" Foreground="#BBFFFFFF" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Status" Text="Drop files here" Foreground="#DDFFFFFF" FontSize="13"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="EmptyText" Text="No activity yet" Foreground="#77FFFFFF" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed"/>

            <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" MaxHeight="260"
                     Margin="10,0,10,10" Visibility="Collapsed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" Foreground="#EEFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Foreground="#88FFFFFF" FontSize="10"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Undo" Tag="{Binding}" Click="Undo_Click"
                                    Style="{StaticResource Flat}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
