<Window x:Class="DropSorter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropSorter settings" Width="840" Height="620" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterScreen" Topmost="True" UseLayoutRounding="True"
        Background="#14161F" Foreground="#E8EAF2" FontSize="13"
        FontFamily="pack://application:,,,/Fonts/#Sora, Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#1B1E2A"/>
        <SolidColorBrush x:Key="Line" Color="#2B3043"/>
        <SolidColorBrush x:Key="Text" Color="#E8EAF2"/>
        <SolidColorBrush x:Key="Muted" Color="#8B90A5"/>
        <SolidColorBrush x:Key="Accent" Color="#6C9EFF"/>
        <SolidColorBrush x:Key="Field" Color="#11131B"/>

        <!-- buttons -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#2A2F42"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"/>
                            <Border x:Name="Hl" Background="#22FFFFFF" CornerRadius="9" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0B1020"/>
        </Style>

        <!-- text boxes -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="#556C9EFF"/>
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6C9EFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="4,5"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- toggle switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#2F3448">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#6C9EFF"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,26,28,10">
            <TextBlock Text="Sorting rules" FontSize="22"/>
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21"
                       Text="Rules run top to bottom and the first match wins. Separate extensions and keywords with commas; if both are filled in, both must match. Variables like %USERPROFILE% work in folder paths."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="28,6,28,0" Padding="6" CornerRadius="14"
                Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserSortColumns="False" CanUserResizeRows="False" CanUserReorderColumns="False"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="None" RowHeaderWidth="0" RowHeight="46"
                      Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                      RowBackground="Transparent" AlternatingRowBackground="Transparent"
                      HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2A3350"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="140"
                                        ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
                    <DataGridTextColumn Header="EXTENSIONS" Binding="{Binding Extensions}" Width="200"
                                        ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
                    <DataGridTextColumn Header="KEYWORDS IN FILE NAME" Binding="{Binding Keywords}" Width="190"
                                        ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
                    <DataGridTextColumn Header="DESTINATION FOLDER" Binding="{Binding Destination}" Width="*"
                                        ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="28,14,28,0">
            <Button Content="+  Add rule" Style="{StaticResource Primary}" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="Remove" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Remove_Click"/>
            <Button Content="↑" Style="{StaticResource Btn}" Padding="14,9" Margin="0,0,8,0" Click="Up_Click" ToolTip="Move up"/>
            <Button Content="↓" Style="{StaticResource Btn}" Padding="14,9" Margin="0,0,8,0" Click="Down_Click" ToolTip="Move down"/>
            <Button Content="Choose folder…" Style="{StaticResource Btn}" Click="BrowseRule_Click"/>
        </StackPanel>

        <Border Grid.Row="3" Margin="28,14,28,0" Padding="16,12" CornerRadius="14"
                Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Unmatched files go to" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BrowseFallback_Click"/>
                <TextBox x:Name="FallbackBox"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="28,20,28,24">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Style="{StaticResource Btn}" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Save changes" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
            <CheckBox x:Name="StartupBox" Style="{StaticResource Switch}" Content="Start DropSorter when I sign in" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
